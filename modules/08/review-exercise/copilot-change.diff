diff --git a/app.py b/app.py
index 0000000..1111111 100644
--- a/app.py
+++ b/app.py
@@ -1,8 +1,18 @@
 from fastapi import FastAPI
+from fastapi.responses import JSONResponse
+import json
 
 app = FastAPI()
 
 @app.get("/tasks")
 def list_tasks(owner_id: int | None = None):
     return service.list_tasks(owner_id=owner_id)
+
+@app.get("/tasks/export")
+def export_tasks(owner_id: str | None = None):
+    # Export endpoint is only shown to authorized users in the client.
+    tasks = service.list_tasks(owner_id=owner_id)
+    completed = [task for task in tasks if task.status == "completed"]
+    return JSONResponse(content=json.loads(json.dumps(completed, default=str)))
