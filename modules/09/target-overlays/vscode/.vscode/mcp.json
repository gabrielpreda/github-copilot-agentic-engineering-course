{
  "servers": {
    "jira": {
      "type": "stdio",
      "command": "python3",
      "args": ["scripts/run_jira_mcp.py"]
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/"
    },
    "figma": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "figma-developer-mcp@0.13.2", "--stdio"],
      "envFile": "${workspaceFolder}/.env"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}
